{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Aaramv locality record v2",
  "description": "Generated from the current live Zod schema. Cross-record references and custom refinements must also pass npm run validate:data.",
  "type": "object",
  "properties": {
    "aaramvPerspective": {
      "type": "string"
    },
    "linkedPropertyIds": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "research": {
      "type": "object",
      "properties": {
        "boundaryCertified": {
          "type": "boolean"
        },
        "checkedAt": {
          "type": "string",
          "description": "Source review date, YYYY-MM-DD; not automatically a quotation or possession date."
        },
        "currentTransitOperatingStatusClaimed": {
          "type": "boolean"
        },
        "imageScope": {
          "type": "string"
        },
        "perspectiveType": {
          "type": "string"
        }
      },
      "required": [
        "boundaryCertified",
        "checkedAt",
        "currentTransitOperatingStatusClaimed",
        "imageScope",
        "perspectiveType"
      ],
      "additionalProperties": false
    },
    "sourceIds": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "usp": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "zoneType": {
      "type": "string"
    },
    "schemaVersion": {
      "const": 2,
      "type": "number",
      "description": "Exactly 2. Do not change existing record IDs."
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "description": "Stable lowercase hyphenated slug; determines the existing page URL."
    },
    "published": {
      "type": "boolean"
    },
    "isDemo": {
      "type": "boolean"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "searchKeywords": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      }
    },
    "coverImageId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "description": "Must match a member of images in this record."
    },
    "images": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "bytes": {
            "type": "number"
          },
          "capturedAt": {
            "anyOf": [
              {
                "type": "string"
              },
              {
