          "width": {
            "type": "number"
          },
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "description": "Stable lowercase hyphenated slug; determines the existing page URL."
          },
          "src": {
            "type": "string",
            "anyOf": [
              {
                "pattern": "^/(?!/)[^\\s\\\\]*$"
              },
              {
                "format": "uri",
                "pattern": "^https://[^\\s\\\\]+$"
              }
            ],
            "description": "Public-relative asset path or HTTPS URL. Run the repository validator to enforce hostname and no-credentials checks."
          },
          "alt": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "caption": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "exterior",
              "interior",
              "amenity",
              "floor-plan",
              "map",
              "locality",
              "master-plan",
              "construction",
              "landmark-photograph",
              "location-map"
