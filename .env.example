# Server-side only. Set in Vercel > Project Settings > Environment Variables.
# For local development, copy to .env.local and supply the key privately.
LEADRAT_API_KEY=
LEADRAT_SUBSOURCE=Aaramv Realty Website

# Optional writable receipt directory for a self-hosted Node server.
# Vercel always delivers directly without depending on filesystem persistence.
# ENQUIRY_STORAGE_DIR=.local/enquiries
